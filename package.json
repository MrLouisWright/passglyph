{
  "name": "passglyph",
  "version": "2.0.0",
  "description": "Egyptian hieroglyphs instead of password dots: matching passwords show the same glyphs, typos show where they happen, nothing is revealed. Per-instance non-extractable HMAC key over each prefix (no per-character mapping), 4-6 bits/glyph, canvas sprite, input stays type=password, dot fallback. React, Vue, <pass-glyph>. Zero deps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/passglyph.global.js",
  "jsdelivr": "./dist/passglyph.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hieroglyphs": {
      "import": {
        "types": "./dist/hieroglyphs.d.ts",
        "default": "./dist/hieroglyphs.mjs"
      },
      "require": {
        "types": "./dist/hieroglyphs.d.cts",
        "default": "./dist/hieroglyphs.cjs"
      }
    },
    "./glyph": {
      "import": {
        "types": "./dist/glyph.d.ts",
        "default": "./dist/glyph.mjs"
      },
      "require": {
        "types": "./dist/glyph.d.cts",
        "default": "./dist/glyph.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.mjs"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./global": "./dist/passglyph.global.js",
    "./element.global": "./dist/passglyph-element.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY-DESIGN.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/element.*",
    "./dist/passglyph-element.global.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "hero": "node scripts/hero.mjs"
  },
  "keywords": [
    "password",
    "password-confirmation",
    "confirm-password",
    "password-mask",
    "hieroglyphs",
    "egyptian-hieroglyphs",
    "typo",
    "visual-hash",
    "hashmask",
    "chroma-hash",
    "web-component",
    "accessibility",
    "react",
    "vue",
    "webcrypto",
    "hmac",
    "forms"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/passglyph.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/passglyph/issues"
  },
  "homepage": "https://mrlouiswright.github.io/passglyph/",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.10",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.44"
  }
}
